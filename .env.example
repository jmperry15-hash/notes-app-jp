# Copy this file to `.env` (which is git-ignored) and fill in your Supabase values.
# Find them in Supabase: Project Settings → API (Project URL and the anon / publishable key).
# The anon key is designed to be public; Row Level Security protects your data.
# NEVER put the service_role / secret key here or anywhere in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
